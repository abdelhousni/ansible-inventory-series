# The image behind db1: Ubuntu 24.04, whose PostgreSQL is 16. Python for
# Ansible's modules (python3-apt for package_facts), and the PostgreSQL 16 client package.
FROM docker.io/library/ubuntu:24.04@sha256:a853f94d226358a79c740cfc7bce0c289748f3fe3488d921d038ccd752c61b60
RUN apt-get update \
    && apt-get install -y --no-install-recommends python3 python3-apt postgresql-client-16 \
    && rm -rf /var/lib/apt/lists/*
CMD ["sleep", "infinity"]
